{
  "name": "tauri-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.ojrah.app",
    "productName": "Ojrah",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main.cjs",
      "server.js",
      "dist/index.html",
      "dist/assets/**/*",
      "package.json"
    ],
    "extraResources": [
      "database.sqlite"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
